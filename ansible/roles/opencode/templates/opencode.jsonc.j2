{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "{{ opencode_provider_id }}": {
      "package": "{{ opencode_provider_package }}",
      "name": "{{ opencode_provider_name }}",
      "settings": {
        "baseURL": "{{ opencode_base_url }}"
      },
      "models": {
{% for model in (llama_swap_models + (gufo_models | default([]))) | selectattr('opencode', 'defined') %}
{% set model_settings = model.opencode | dict2items | rejectattr('key', 'in', ['reasoning', 'tools']) | list | items2dict %}
{% set model_capabilities = opencode_model_capabilities | combine({'tools': model.opencode.tools | default(opencode_model_capabilities.tools)}) | combine(model.opencode.capabilities | default({})) %}
        "{{ model.name }}": {{ {'name': model.name} | combine(model_settings) | combine({'capabilities': model_capabilities}) | to_json }}{{ "," if not loop.last else "" }}
{% endfor %}
      }
    }
  },

  "model": "{{ opencode_default_model }}",

  "agents": {
    "build": {
      "description": "Default coding mode with only OpenCode tools.",
      "system": "{file:./AGENTS.md}"
    },
    "title": {
      "model": "{{ opencode_small_model }}"
    }
  }
}
