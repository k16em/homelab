{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",
    "retention": {
      "delay": "24h",
      "policies": [
        {
          "repositories": ["**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            {
              "pulledWithin": {{ zot_keep_pulled_within | to_json }}
            }
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"]
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
{% for registry in zot_sync_registries %}
        {
          "urls": [{{ registry.url | to_json }}],
          "onDemand": true,
          "tlsVerify": true,
          "preserveDigest": true,
          "content": [
            {
              "prefix": "**",
              "destination": {{ ('/' ~ registry.destination) | to_json }}
            }
          ]
        }{{ '' if loop.last else ',' }}
{% endfor %}
      ]
    }
  }
}
