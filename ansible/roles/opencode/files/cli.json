{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "prompt"
  },
  "mini": {
    "thinking": "hide"
  },
  "animations": true,
  "theme": {
    "name": "solarized",
    "mode": "light"
  },
  "tabs": {
    "layout": "vertical"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
